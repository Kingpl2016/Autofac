{
  "version": 2,
  "effects": [
    {
      "id": "circle", "group": "position", "icon": "orbit", "scale": "fraction",
      "name": { "zh": "画圆", "en": "Circle" },
      "hint": { "zh": "Pan / Tilt 正弦错开 1/4 周期，光束画圆", "en": "Pan and tilt sines a quarter cycle apart draw a circle" },
      "period": { "kind": "beats", "beats": 4 }, "size": 0.15, "spread": 1, "spreadBy": "phase",
      "look": {
        "intensity": { "value": 1 },
        "attrs": {
          "pan": { "shape": "sine", "center": 0.5, "amp": 1 },
          "tilt": { "shape": "sine", "center": 0.5, "amp": 1, "phase": 0.25 }
        }
      }
    },
    {
      "id": "figure8", "group": "position", "icon": "infinity", "scale": "fraction",
      "name": { "zh": "8 字", "en": "Figure 8" },
      "hint": { "zh": "Tilt 频率是 Pan 的两倍，光束走 8 字", "en": "Tilt runs twice as fast as pan for a figure eight" },
      "period": { "kind": "beats", "beats": 8 }, "size": 0.15, "spread": 1, "spreadBy": "phase",
      "look": {
        "intensity": { "value": 1 },
        "attrs": {
          "pan": { "shape": "sine", "center": 0.5, "amp": 1 },
          "tilt": { "shape": "sine", "center": 0.5, "amp": 0.5, "cycles": 2, "phase": 0.25 }
        }
      }
    },
    {
      "id": "diamond", "group": "position", "icon": "diamond", "scale": "fraction",
      "name": { "zh": "菱形", "en": "Diamond" },
      "hint": { "zh": "Pan / Tilt 三角波错开 1/4 周期，光束走菱形", "en": "Triangle waves a quarter cycle apart trace a diamond" },
      "period": { "kind": "beats", "beats": 4 }, "size": 0.15, "spread": 1, "spreadBy": "phase",
      "look": {
        "intensity": { "value": 1 },
        "attrs": {
          "pan": { "shape": "triangle", "center": 0.5, "amp": 1 },
          "tilt": { "shape": "triangle", "center": 0.5, "amp": 1, "phase": 0.25 }
        }
      }
    },
    {
      "id": "square", "group": "position", "icon": "square", "scale": "fraction",
      "name": { "zh": "四角跳点", "en": "Square" },
      "hint": { "zh": "方波驱动，光束在四个角之间跳", "en": "Square waves jump the beam between four corners" },
      "period": { "kind": "beats", "beats": 4 }, "size": 0.15, "spread": 0.5, "spreadBy": "phase",
      "look": {
        "intensity": { "value": 1 },
        "attrs": {
          "pan": { "shape": "square", "center": 0.5, "amp": 1, "duty": 0.5 },
          "tilt": { "shape": "square", "center": 0.5, "amp": 1, "duty": 0.5, "phase": 0.25 }
        }
      }
    },
    {
      "id": "panSweep", "group": "position", "icon": "moveHorizontal", "scale": "fraction",
      "name": { "zh": "水平扫动", "en": "Pan sweep" },
      "hint": { "zh": "Pan 三角波来回扫", "en": "Pan sweeps back and forth" },
      "period": { "kind": "beats", "beats": 4 }, "size": 0.25, "spread": 0.5, "spreadBy": "phase",
      "look": { "intensity": { "value": 1 }, "attrs": { "pan": { "shape": "triangle", "center": 0.5, "amp": 1 } } }
    },
    {
      "id": "tiltSweep", "group": "position", "icon": "moveVertical", "scale": "fraction",
      "name": { "zh": "垂直扫动", "en": "Tilt sweep" },
      "hint": { "zh": "Tilt 三角波上下扫", "en": "Tilt sweeps up and down" },
      "period": { "kind": "beats", "beats": 4 }, "size": 0.2, "spread": 0.5, "spreadBy": "phase",
      "look": { "intensity": { "value": 1 }, "attrs": { "tilt": { "shape": "triangle", "center": 0.5, "amp": 1 } } }
    },
    {
      "id": "fan", "group": "position", "icon": "fan", "scale": "fraction",
      "name": { "zh": "扇形展开", "en": "Fan" },
      "hint": { "zh": "分组成员的 Pan 从左到右展开成扇形，并轻微摆动", "en": "Members fan out across pan with a gentle sway" },
      "period": { "kind": "beats", "beats": 8 }, "size": 0.25, "spread": 0, "spreadBy": "none",
      "look": { "intensity": { "value": 1 }, "attrs": { "tilt": { "shape": "sine", "center": 0.5, "amp": 0.2 } } },
      "fan": { "attr": "pan", "amp": 1 }
    },
    {
      "id": "randomMove", "group": "position", "icon": "shuffle", "scale": "fraction",
      "name": { "zh": "随机走位", "en": "Random move" },
      "hint": { "zh": "Pan / Tilt 每个周期随机换一个位置", "en": "Pan and tilt jump to a random spot each cycle" },
      "period": { "kind": "beats", "beats": 2 }, "size": 0.2, "spread": 0.37, "spreadBy": "phase",
      "look": {
        "intensity": { "value": 1 },
        "attrs": {
          "pan": { "shape": "random", "center": 0.5, "amp": 1 },
          "tilt": { "shape": "random", "center": 0.5, "amp": 1, "phase": 0.5 }
        }
      }
    },
    {
      "id": "intensityWave", "group": "intensity", "icon": "waves", "scale": "percent",
      "name": { "zh": "强度波浪", "en": "Intensity wave" },
      "hint": { "zh": "强度正弦起伏，分组成员依次错开形成波浪", "en": "Intensity rises and falls, offset along the group like a wave" },
      "period": { "kind": "beats", "beats": 2 }, "size": 100, "spread": 1, "spreadBy": "phase",
      "look": { "intensity": { "shape": "sine", "lo": 0, "hi": 1 } }
    },
    {
      "id": "intensityChase", "group": "intensity", "icon": "moveRight", "scale": "percent",
      "name": { "zh": "强度追逐", "en": "Intensity chase" },
      "hint": { "zh": "分组成员轮流点亮", "en": "Members light up one after another" },
      "period": { "kind": "beats", "beats": 1 }, "size": 100, "spread": 1, "spreadBy": "phase",
      "look": { "intensity": { "shape": "square", "lo": 0, "hi": 1, "duty": "members" } }
    },
    {
      "id": "breathe", "group": "intensity", "icon": "activity", "scale": "percent",
      "name": { "zh": "呼吸", "en": "Breathe" },
      "hint": { "zh": "整组一起缓慢明暗起伏，不熄灭", "en": "The whole group slowly breathes without going dark" },
      "period": { "kind": "beats", "beats": 4 }, "size": 100, "spread": 0, "spreadBy": "phase",
      "params": [{ "id": "floor", "type": "percent", "default": 0.2, "label": { "zh": "最暗", "en": "Lowest" } }],
      "look": { "intensity": { "shape": "sine", "lo": "$floor", "hi": 1 } }
    },
    {
      "id": "pulse", "group": "intensity", "icon": "zap", "scale": "percent",
      "name": { "zh": "脉冲", "en": "Pulse" },
      "hint": { "zh": "每拍瞬间点亮后衰减（锯齿波）", "en": "Snaps on each beat and decays (saw wave)" },
      "period": { "kind": "beats", "beats": 1 }, "size": 100, "spread": 0.5, "spreadBy": "phase",
      "look": { "intensity": { "shape": "saw", "lo": 1, "hi": 0 } }
    },
    {
      "id": "flicker", "group": "intensity", "icon": "sparkles", "scale": "percent",
      "name": { "zh": "随机闪烁", "en": "Random flicker" },
      "hint": { "zh": "强度随机跳动，成员之间各不相同", "en": "Intensity jumps randomly, different for each member" },
      "period": { "kind": "ms", "ms": 250 }, "size": 100, "spread": 0, "spreadBy": "none",
      "params": [{ "id": "floor", "type": "percent", "default": 0.1, "label": { "zh": "最暗", "en": "Lowest" } }],
      "look": { "intensity": { "shape": "random", "lo": "$floor", "hi": 1, "seed": true } }
    },
    {
      "id": "candle", "group": "intensity", "icon": "flame", "scale": "percent",
      "name": { "zh": "烛光", "en": "Candle" },
      "hint": { "zh": "平滑噪声，每台灯各自轻轻摇曳", "en": "Smooth noise; each fixture flickers gently on its own" },
      "period": { "kind": "ms", "ms": 180 }, "size": 100, "spread": 0, "spreadBy": "none",
      "params": [{ "id": "floor", "type": "percent", "default": 0.55, "label": { "zh": "最暗", "en": "Lowest" } }],
      "look": { "intensity": { "shape": "noise", "lo": "$floor", "hi": 1, "seed": true } }
    },
    {
      "id": "fadeIn", "group": "intensity", "icon": "sunrise", "scale": "percent",
      "name": { "zh": "渐亮", "en": "Fade in" },
      "hint": { "zh": "整段从暗到亮走一次；有分组时依次渐亮", "en": "Fades up once over the clip; members follow one after another" },
      "period": { "kind": "beats", "beats": 4 }, "size": 100, "spread": 1, "spreadBy": "delay",
      "look": { "intensity": { "shape": "ramp", "lo": 0, "hi": 1, "once": true } }
    },
    {
      "id": "fadeOut", "group": "intensity", "icon": "sunset", "scale": "percent",
      "name": { "zh": "渐暗", "en": "Fade out" },
      "hint": { "zh": "整段从亮到暗走一次；有分组时依次渐暗", "en": "Fades down once over the clip; members follow one after another" },
      "period": { "kind": "beats", "beats": 4 }, "size": 100, "spread": 1, "spreadBy": "delay",
      "look": { "intensity": { "shape": "ramp", "lo": 1, "hi": 0, "once": true } }
    },
    {
      "id": "strobe", "group": "intensity", "icon": "zap", "scale": "percent",
      "name": { "zh": "频闪", "en": "Strobe" },
      "hint": { "zh": "强度方波（注意频闪安全）", "en": "Intensity square wave (mind strobe safety)" },
      "period": { "kind": "ms", "ms": 125 }, "size": 100, "spread": 0, "spreadBy": "none",
      "params": [{ "id": "duty", "type": "percent", "default": 0.5, "label": { "zh": "亮的比例", "en": "On time" } }],
      "look": { "intensity": { "shape": "square", "lo": 0, "hi": 1, "duty": "$duty" } }
    },
    {
      "id": "rainbow", "group": "color", "icon": "rainbow", "scale": "percent",
      "name": { "zh": "彩虹", "en": "Rainbow" },
      "hint": { "zh": "颜色沿色相循环，分组成员错开色相", "en": "Cycles through the hues, offset across the group" },
      "period": { "kind": "beats", "beats": 8 }, "size": 100, "spread": 1, "spreadBy": "hue",
      "look": {
        "intensity": { "value": 1 },
        "color": { "colors": [[255, 0, 0], [255, 255, 0], [0, 255, 0], [0, 255, 255], [0, 0, 255], [255, 0, 255]], "blend": "smooth" }
      }
    },
    {
      "id": "twoColor", "group": "color", "icon": "repeat", "scale": "percent",
      "name": { "zh": "双色交替", "en": "Two-color alternate" },
      "hint": { "zh": "两种颜色按拍切换；分组成员错开半拍形成交错", "en": "Switches between two colors on the beat; members alternate" },
      "period": { "kind": "beats", "beats": 2 }, "size": 100, "spread": 0.5, "spreadBy": "delay",
      "params": [{ "id": "colors", "type": "colors", "default": [[255, 0, 0], [0, 64, 255]], "min": 2, "max": 8, "label": { "zh": "颜色", "en": "Colors" } }],
      "look": { "intensity": { "value": 1 }, "color": { "colors": "$colors", "blend": "step" } }
    },
    {
      "id": "colorChase", "group": "color", "icon": "palette", "scale": "percent",
      "name": { "zh": "颜色追逐", "en": "Color chase" },
      "hint": { "zh": "红、绿、蓝依次跳变，沿分组推进", "en": "Steps red, green, blue and travels along the group" },
      "period": { "kind": "beats", "beats": 3 }, "size": 100, "spread": 1, "spreadBy": "delay",
      "params": [{ "id": "colors", "type": "colors", "default": [[255, 0, 0], [0, 255, 0], [0, 0, 255]], "min": 2, "max": 8, "label": { "zh": "颜色", "en": "Colors" } }],
      "look": { "intensity": { "value": 1 }, "color": { "colors": "$colors", "blend": "step" } }
    },
    {
      "id": "hueSweep", "group": "color", "icon": "blend", "scale": "percent",
      "name": { "zh": "冷暖扫色", "en": "Warm-cool sweep" },
      "hint": { "zh": "在暖橙、品红、紫、冰蓝之间平滑过渡", "en": "Glides between amber, magenta, violet and ice blue" },
      "period": { "kind": "beats", "beats": 16 }, "size": 100, "spread": 0.5, "spreadBy": "delay",
      "params": [{ "id": "colors", "type": "colors", "default": [[255, 96, 0], [255, 0, 128], [128, 0, 255], [0, 160, 255]], "min": 2, "max": 8, "label": { "zh": "颜色", "en": "Colors" } }],
      "look": { "intensity": { "value": 1 }, "color": { "colors": "$colors", "blend": "smooth" } }
    },
    {
      "id": "gradient", "group": "color", "icon": "blend", "scale": "percent",
      "name": { "zh": "流动渐变", "en": "Flowing gradient" },
      "hint": { "zh": "一组颜色平滑循环，沿分组流动", "en": "Colors blend smoothly in a loop and flow along the group" },
      "period": { "kind": "ms", "ms": 8000 }, "size": 100, "spread": 1, "spreadBy": "phase",
      "params": [
        { "id": "colors", "type": "colors", "default": [[255, 0, 0], [0, 0, 255]], "min": 2, "max": 8, "label": { "zh": "颜色", "en": "Colors" } },
        {
          "id": "blend", "type": "choice", "default": "smooth", "label": { "zh": "过渡", "en": "Blend" },
          "options": [
            { "value": "smooth", "label": { "zh": "平滑", "en": "Smooth" } },
            { "value": "hue", "label": { "zh": "沿色相", "en": "Along hue" } }
          ]
        }
      ],
      "look": { "intensity": { "value": 1 }, "color": { "colors": "$colors", "blend": "$blend" } }
    },
    {
      "id": "wipe", "group": "color", "icon": "chevronsRight", "scale": "percent",
      "name": { "zh": "颜色擦除", "en": "Color wipe" },
      "hint": { "zh": "颜色依次扫过分组：第一种颜色推过去，再被下一种推回来", "en": "Each color sweeps across the group in turn" },
      "period": { "kind": "beats", "beats": 8 }, "size": 100, "spread": 1, "spreadBy": "phase",
      "params": [{ "id": "colors", "type": "colors", "default": [[255, 0, 0], [0, 0, 255]], "min": 2, "max": 8, "label": { "zh": "颜色", "en": "Colors" } }],
      "look": { "intensity": { "value": 1 }, "color": { "colors": "$colors", "blend": "step" } }
    },
    {
      "id": "sparkle", "group": "color", "icon": "sparkles", "scale": "percent",
      "name": { "zh": "星光闪烁", "en": "Sparkle" },
      "hint": { "zh": "每台灯随机点亮后衰减，密度可调", "en": "Fixtures light up at random and fade; density is adjustable" },
      "period": { "kind": "ms", "ms": 250 }, "size": 100, "spread": 0, "spreadBy": "none",
      "params": [
        { "id": "density", "type": "percent", "default": 0.3, "label": { "zh": "密度", "en": "Density" } },
        { "id": "color", "type": "color", "default": [255, 255, 255], "label": { "zh": "颜色", "en": "Color" } }
      ],
      "look": {
        "intensity": { "shape": "random", "lo": 0, "hi": 1, "duty": "$density", "ease": "linear", "seed": true },
        "color": { "rgb": "$color" }
      }
    },
    {
      "id": "zoomBreathe", "group": "beam", "icon": "zoomIn", "scale": "fraction",
      "name": { "zh": "变焦呼吸", "en": "Zoom breathe" },
      "hint": { "zh": "光束角在宽窄之间缓慢变化", "en": "Beam angle slowly widens and narrows" },
      "period": { "kind": "beats", "beats": 8 }, "size": 0.4, "spread": 0.5, "spreadBy": "phase",
      "look": { "attrs": { "zoom": { "shape": "sine", "center": 0.5, "amp": 1 } } }
    },
    {
      "id": "irisPulse", "group": "beam", "icon": "aperture", "scale": "fraction",
      "name": { "zh": "光圈脉冲", "en": "Iris pulse" },
      "hint": { "zh": "光圈每拍收紧后张开", "en": "Iris snaps closed on the beat and reopens" },
      "period": { "kind": "beats", "beats": 1 }, "size": 0.5, "spread": 0, "spreadBy": "phase",
      "look": { "attrs": { "iris": { "shape": "saw", "center": 0.5, "amp": 1 } } }
    },
    {
      "id": "goboSpin", "group": "beam", "icon": "rotateCw", "scale": "fraction",
      "name": { "zh": "图案旋转", "en": "Gobo spin" },
      "hint": { "zh": "图案轮持续旋转（大小决定转速）", "en": "Spins the gobo continuously (size sets the speed)" },
      "period": { "kind": "beats", "beats": 4 }, "size": 0.25, "spread": 0, "spreadBy": "none",
      "look": { "attrs": { "goboRotate": { "shape": "sine", "center": 0.75, "amp": 0.1 } } }
    },
    {
      "id": "prismSpin", "group": "beam", "icon": "rotateCw", "scale": "fraction",
      "name": { "zh": "棱镜摆动", "en": "Prism sway" },
      "hint": { "zh": "棱镜来回旋转，分组成员错开", "en": "Prism rotates back and forth, offset across the group" },
      "period": { "kind": "beats", "beats": 8 }, "size": 0.3, "spread": 0.5, "spreadBy": "phase",
      "look": { "attrs": { "prismRotate": { "shape": "triangle", "center": 0.5, "amp": 1 } } }
    },
    {
      "id": "heartbeat", "group": "intensity", "icon": "heartPulse", "scale": "percent",
      "name": { "zh": "心跳", "en": "Heartbeat" },
      "hint": { "zh": "两下一组的强弱跳动后停顿，像心跳", "en": "A strong and a weak beat followed by a pause, like a heartbeat" },
      "period": { "kind": "beats", "beats": 2 }, "size": 100, "spread": 0, "spreadBy": "none",
      "params": [{ "id": "floor", "type": "percent", "default": 0.05, "label": { "zh": "最暗", "en": "Lowest" } }],
      "look": { "intensity": { "shape": "steps", "lo": "$floor", "hi": 1, "steps": [0, 1, 0.15, 0.7, 0, 0, 0, 0], "ease": "easeOut", "transition": 0.6 } }
    },
    {
      "id": "lightning", "group": "intensity", "icon": "cloudLightning", "scale": "percent",
      "name": { "zh": "雷电", "en": "Lightning" },
      "hint": { "zh": "偶发的短促强闪并迅速衰减，每台灯不同", "en": "Occasional short bright flashes that decay fast, different on every fixture" },
      "period": { "kind": "ms", "ms": 80 }, "size": 100, "spread": 0, "spreadBy": "none",
      "params": [{ "id": "density", "type": "percent", "default": 0.06, "label": { "zh": "密度", "en": "Density" } }],
      "look": { "intensity": { "shape": "random", "lo": 0, "hi": 1, "duty": "$density", "ease": "easeOut", "seed": true } }
    },
    {
      "id": "randomStrobe", "group": "intensity", "icon": "shuffle", "scale": "percent",
      "name": { "zh": "随机频闪", "en": "Random strobe" },
      "hint": { "zh": "每台灯随机地全亮或全灭，频闪节奏", "en": "Each fixture randomly snaps fully on or off at strobe speed" },
      "period": { "kind": "ms", "ms": 100 }, "size": 100, "spread": 0, "spreadBy": "none",
      "params": [{ "id": "density", "type": "percent", "default": 0.3, "label": { "zh": "亮的比例", "en": "On ratio" } }],
      "look": { "intensity": { "shape": "random", "lo": 0, "hi": 1, "duty": "$density", "seed": true } }
    },
    {
      "id": "comet", "group": "intensity", "icon": "chevronsRight", "scale": "percent",
      "name": { "zh": "拖尾追逐", "en": "Comet chase" },
      "hint": { "zh": "亮点沿分组跑动，身后留下渐暗的尾巴", "en": "A bright point runs along the group, leaving a fading tail" },
      "period": { "kind": "beats", "beats": 2 }, "size": 100, "spread": 1, "spreadBy": "phase",
      "look": { "intensity": { "shape": "steps", "lo": 0, "hi": 1, "steps": [1, 0.55, 0.28, 0.12, 0.04, 0, 0, 0], "ease": "linear" } }
    },
    {
      "id": "scanBar", "group": "intensity", "icon": "scanLine", "scale": "percent",
      "name": { "zh": "光带扫描", "en": "Scan bar" },
      "hint": { "zh": "一段柔和的亮带沿分组移动", "en": "A soft band of light moves along the group" },
      "period": { "kind": "beats", "beats": 4 }, "size": 100, "spread": 1, "spreadBy": "phase",
      "look": { "intensity": { "shape": "steps", "lo": 0, "hi": 1, "steps": [0, 0.35, 1, 0.35, 0, 0, 0, 0, 0, 0], "ease": "easeInOut" } }
    },
    {
      "id": "hit", "group": "intensity", "icon": "sun", "scale": "percent",
      "name": { "zh": "爆闪冲击", "en": "Blinder hit" },
      "hint": { "zh": "每小节一次全亮冲击并快速衰减，配合重拍", "en": "A full-on hit once per bar that decays quickly, for downbeats" },
      "period": { "kind": "beats", "beats": 4 }, "size": 100, "spread": 0, "spreadBy": "none",
      "params": [{ "id": "decay", "type": "percent", "default": 0.4, "label": { "zh": "衰减时长", "en": "Decay" } }],
      "look": { "intensity": { "shape": "saw", "lo": 1, "hi": 0, "ease": "easeOut", "transition": "$decay" } }
    },
    {
      "id": "fire", "group": "color", "icon": "flame", "scale": "percent",
      "name": { "zh": "火焰", "en": "Fire" },
