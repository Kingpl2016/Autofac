# ESP32-P4 Art-Net 核心板默认配置（可被 idf.py menuconfig 覆盖后保存到 sdkconfig）
#
# 基线取自 Waveshare ESP32-P4-Platform 官方示例，并按本固件需求补充 FATFS / OTA /
# coredump / 分区表等项。各项含义见 README 与行内注释。

CONFIG_IDF_TARGET="esp32p4"

#
# Flash 与 PSRAM（模组 32MB NOR Flash + 32MB 叠封 PSRAM；按官方示例以 16MB 烧录布局）
#
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

#
# 自定义分区表（双 OTA + coredump）
#
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

#
# OTA 升级：启用首启回滚（新固件自检通过才确认，否则下次启动回退旧固件）
#
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_APP_ANTI_ROLLBACK=n

#
# Coredump 落 flash（ELF 格式 + SHA256 校验，供崩溃后远程取回分析）
#
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_SHA256=y
CONFIG_ESP_COREDUMP_STACK_SIZE=1024

#
# FreeRTOS：1000Hz tick 便于回放调度按毫秒对齐
#
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

#
# FATFS 调优（大文件顺序读 + 时间二分随机 seek 的回放画像）
#   - FASTSEEK：只读文件建 CLMT，lseek 近 O(1)，对 seek / 循环 / 二分定位关键
#   - ALIGNED_WORK_BUFFERS：P4 + PSRAM + SDMMC DMA 专用，少一次拷贝
#   - PREFER_EXTRAM=n：FATFS 内部缓冲放内部 RAM（热路径优先性能）
#   - PER_FILE_CACHE：回放 / 上传 / 索引文件并发时各自独立 cache
#   - UTF-8 文件名 + 936 代码页：支持中文节目名
#
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_USE_FASTSEEK=y
CONFIG_FATFS_FAST_SEEK_BUFFER_SIZE=64
CONFIG_FATFS_ALLOC_PREFER_ALIGNED_WORK_BUFFERS=y
CONFIG_FATFS_PER_FILE_CACHE=y
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FATFS_CODEPAGE_936=y
CONFIG_FATFS_VFS_FSTAT_BLKSIZE=4096

#
# HTTP 服务（文件 / 控制 / OTA 共用一个实例）
#
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

#
# OTA 分段下载（本工程用推送式，不依赖拉取，但保留以备后续）
#
CONFIG_ESP_HTTPS_OTA_ENABLE_PARTIAL_DOWNLOAD=n

#
# 主任务栈与编译优化
#
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_COMPILER_OPTIMIZATION_PERF=y

#
# 任务看门狗（调度 / 网络任务喂狗，详见 player 与 net 组件）
#
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

#
# 引导加载器瘦身：P4 默认引导器体积接近分区表偏移 0x8000 给出的 0x6000 上限，
# 用大小优化 + 降低引导日志等级把体积压回上限内（否则报 bootloader too large）。
#
CONFIG_BOOTLOADER_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
