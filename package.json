{
  "name": "art-net-studio",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "description": "Art-Net Studio —— Art-Net / sACN 灯光控制与录制平台",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-wasm.mjs && tsc -b && vite build",
    "build:wasm": "node scripts/build-wasm.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/ --concurrency auto",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "knip": "knip",
    "gen:types": "node scripts/gen-bindings.mjs",
    "check:types": "node scripts/gen-bindings.mjs --check",
    "verify": "node scripts/verify.mjs",
    "verify:changed": "node scripts/verify.mjs --changed",
    "ai:eval": "vitest run --config vitest.eval.config.ts"
  },
  "dependencies": {
